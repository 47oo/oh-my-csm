# Copy to .env before running docker compose up -d
APP_NAME=Oh-My-CSM
APP_ENV=production
HTTP_PORT=8080

POSTGRES_DB=oh_my_csm
POSTGRES_USER=csm
POSTGRES_PASSWORD=csm_change_me_strong_password

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_64_CHAR_SECRET

# AES-256-GCM versioned key ring (32-byte base64 key). Keep backed up separately from DB!
# Generate with: python3 -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
CSM_SECRET_KEYS={"1":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="}
CSM_ACTIVE_KEY_VERSION=1

INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=Admin123456
CORS_ORIGINS=http://localhost:8080
